{
"update_url": "https://clients2.google.com/service/update2/crx",

	"manifest_version": 3,
	"name": "单合源代码", 
	"version": "4.0",
	"description": "查看网页源代码与渲染后代码的差异。看看浏览器如何渲染页面，而不仅仅是服务器发送的内容。", 
	"icons": {
		"16": "icon16.png",
		"32": "icon32.png",
		"48": "icon48.png",
		"128": "icon128.png"
	},
	"action": {
		"default_title": "单合源代码"
	},
	"author": "danhe.com",
	"background": {
		"service_worker": "background.js"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Alt+U"
			}
		  }
	},
	"content_scripts": [
	{
		"run_at": "document_start",
		"matches": ["<all_urls>"],
		"js": ["content.js"]
	}],
	"permissions": [
		"contextMenus",
		"storage"
	],
	"host_permissions": [
		"http://*/*",
		"https://*/*"
	]
}